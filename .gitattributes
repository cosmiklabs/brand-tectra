# Text files are stored and checked out with LF on every platform, so that
# asset-manifest.json hashes and generated token output match byte for byte.
* text=auto eol=lf
*.svg text eol=lf
*.css text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.rs text eol=lf

# The vendored foundation is locked by SHA-256 in vendor/brand/brand.lock.json;
# never convert its bytes on checkout.
vendor/brand/** -text

*.png binary
*.ttf binary
*.woff2 binary
